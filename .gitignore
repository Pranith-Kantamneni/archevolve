# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# ARCHEVOLVE runtime state (generated per run, never committed)
runs/
experience_memory.json
*.log

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenvs
.venv/
venv/
.env

# OS artifacts
.DS_Store
Thumbs.db

# Local secret overrides (keys must only ever travel via env vars)
.env.local
